  }
}

DEF STATIC_OBS_4 Solid {
  translation -1.2 -1.0 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.45 0.70
        roughness 0.3
      }
      geometry Box {
        size 0.5 0.5 0.5
      }
    }
  ]
  name "obs_box_4"
  boundingObject Box {
