#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info [
    "Autonomous Mobile Robot Indoor Navigation Simulation"
    "B.Tech Engineering Major Project"
    "Differential Drive Robot with 360 Lidar and Dynamic Obstacle Avoidance"
  ]
  title "Autonomous Mobile Robot Navigation"
  basicTimeStep 32
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.25 0.35 -0.90 2.2
  position -0.5 -5.8 5.2
  near 0.05
}

TexturedBackground {
  luminosity 0.8
}

TexturedBackgroundLight {
  luminosity 0.8
}

DirectionalLight {
  direction 0.2 0.3 -1
  intensity 1.5
  castShadows TRUE
}

DirectionalLight {
  direction -0.4 -0.2 -0.8
  intensity 0.8
}

# -------------------------------------------------------------
# Arena Floor (6.0m x 6.0m)
# -------------------------------------------------------------
DEF ARENA_FLOOR Solid {
  translation 0 0 -0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.22 0.24 0.28
        roughness 0.4
        metalness 0.1
      }
      geometry Box {
        size 6.0 6.0 0.02
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 6.0 6.0 0.02
  }
}

# -------------------------------------------------------------
# Outer Boundary Walls
# -------------------------------------------------------------
DEF WALL_NORTH Solid {
  translation 0 3.05 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.88
        roughness 0.6
      }
      geometry Box {
        size 6.2 0.1 0.5
      }
    }
  ]
  name "wall_north"
  boundingObject Box {
    size 6.2 0.1 0.5
  }
}

DEF WALL_SOUTH Solid {
  translation 0 -3.05 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.88
        roughness 0.6
      }
      geometry Box {
        size 6.2 0.1 0.5
      }
    }
  ]
  name "wall_south"
  boundingObject Box {
    size 6.2 0.1 0.5
  }
}

DEF WALL_EAST Solid {
  translation 3.05 0 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.88
        roughness 0.6
      }
      geometry Box {
        size 0.1 6.2 0.5
      }
    }
  ]
  name "wall_east"
  boundingObject Box {
    size 0.1 6.2 0.5
  }
}

DEF WALL_WEST Solid {
  translation -3.05 0 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.88
        roughness 0.6
      }
      geometry Box {
        size 0.1 6.2 0.5
      }
    }
  ]
  name "wall_west"
  boundingObject Box {
    size 0.1 6.2 0.5
  }
}

# -------------------------------------------------------------
# Static Indoor Obstacles (Cabinets, Pillars, Desks)
# -------------------------------------------------------------
DEF STATIC_OBS_1 Solid {
  translation -0.8 0.0 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.45 0.70
        roughness 0.3
      }
      geometry Box {
        size 0.6 0.6 0.5
      }
    }
  ]
  name "obs_box_1"
  boundingObject Box {
    size 0.6 0.6 0.5
  }
}

DEF STATIC_OBS_2 Solid {
  translation 0.8 -0.5 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.45 0.70
        roughness 0.3
      }
      geometry Box {
        size 0.6 0.6 0.5
      }
    }
  ]
  name "obs_box_2"
  boundingObject Box {
    size 0.6 0.6 0.5
  }
}

DEF STATIC_OBS_3 Solid {
  translation 0.0 1.2 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.45 0.70
        roughness 0.3
      }
      geometry Box {
        size 0.8 0.5 0.5
      }
    }
  ]
  name "obs_box_3"
  boundingObject Box {
