# -------------------------------------------------------------
# Dynamic Obstacle (Staged below arena floor at z = -5.0)
# Translated into robot path by Webots Controller Supervisor API.
# Static solid (no gravity falling) so LiDAR detects it accurately.
# -------------------------------------------------------------
DEF DYNAMIC_OBSTACLE Solid {
  translation 0 0 -5.0
  rotation 0 0 1 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.25 0.15
        roughness 0.2
        metalness 0.3
        emissiveColor 0.25 0.05 0.0
      }
      geometry Box {
        size 0.45 0.45 0.45
      }
    }
  ]
  name "dynamic_obstacle"
  boundingObject Box {
    size 0.45 0.45 0.45
  }
}

# -------------------------------------------------------------
# Target Destination Visual Goal Marker
# Displays target waypoint on the arena floor (non-colliding).
# Position is updated dynamically by Supervisor controller.
# -------------------------------------------------------------
DEF TARGET_GOAL Solid {
  translation 2.0 2.0 0.005
  rotation 0 0 1 0
  children [
    Pose {
      translation 0 0 0.002
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.85 0.3
            roughness 0.2
            metalness 0.1
            emissiveColor 0.2 0.9 0.4
          }
          geometry Cylinder {
            height 0.004
            radius 0.22
          }
        }
      ]
    }
    Pose {
      translation 0 0 0.005
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.85 0.1
            roughness 0.2
            metalness 0.2
            emissiveColor 0.9 0.8 0.1
          }
          geometry Cylinder {
            height 0.004
            radius 0.12
          }
        }
      ]
    }
    Pose {
      translation 0 0 0.20
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.85 0.3
            roughness 0.2
            metalness 0.5
            emissiveColor 0.1 0.8 0.3
          }
          geometry Cylinder {
            height 0.40
            radius 0.015
          }
        }
      ]
    }
    Pose {
      translation 0 0 0.42
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1.0 0.9 0.1
            roughness 0.1
            emissiveColor 1.0 0.8 0.0
          }
          geometry Sphere {
            radius 0.04
          }
        }
      ]
    }
  ]
  name "target_goal"
}

# -------------------------------------------------------------
# Differential Drive Autonomous Mobile Robot
# -------------------------------------------------------------
DEF ROBOT Robot {
  translation -2.0 -2.0 0.04
  rotation 0 0 1 0
  children [
    # Main Body Chassis (Raised slightly for 1.5cm ground clearance)
    Pose {
      translation 0 0 0.015
      children [
        DEF CHASSIS Shape {
          appearance PBRAppearance {
            baseColor 0.92 0.92 0.94
            roughness 0.2
            metalness 0.5
          }
          geometry Cylinder {
            height 0.06
            radius 0.14
          }
        }
      ]
    }

    # Robot Top Lid
    Pose {
      translation 0 0 0.048
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.15 0.18
            roughness 0.3
          }
          geometry Cylinder {
            height 0.006
            radius 0.13
          }
        }
      ]
    }

    # Heading Indicator Arrow (Pointing forward along +X)
    Pose {
      translation 0.08 0 0.053
      rotation 0 0 1 1.5708
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.8 0.2
          }
          geometry Box {
            size 0.02 0.08 0.005
          }
        }
      ]
    }

    # Left Wheel Joint
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.08 0
      }
      device [
        RotationalMotor {
          name "left_wheel_motor"
          maxVelocity 6.28
        }
      ]
      endPoint DEF LEFT_WHEEL Solid {
        translation 0 0.08 0
        rotation 1 0 0 1.5708
        name "left_wheel"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.8
            }
            geometry Cylinder {
              height 0.025
              radius 0.04
            }
          }
        ]
        boundingObject Cylinder {
          height 0.025
          radius 0.04
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }

    # Right Wheel Joint
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.08 0
      }
      device [
        RotationalMotor {
          name "right_wheel_motor"
          maxVelocity 6.28
        }
      ]
      endPoint DEF RIGHT_WHEEL Solid {
        translation 0 -0.08 0
        rotation 1 0 0 1.5708
        name "right_wheel"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.8
            }
            geometry Cylinder {
              height 0.025
              radius 0.04
            }
          }
        ]
        boundingObject Cylinder {
          height 0.025
          radius 0.04
        }
        physics Physics {
          density -1
          mass 0.4
        }
      }
    }

    # Front Passive Caster Wheel (Low-friction ball touching floor at z=0)
    DEF CASTER_FRONT Solid {
      translation 0.10 0 -0.02
      name "caster_front"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.7 0.7 0.7
            metalness 0.9
            roughness 0.1
          }
          geometry Sphere {
            radius 0.02
          }
        }
      ]
      boundingObject Sphere {
        radius 0.02
      }
      physics Physics {
        density -1
        mass 0.1
      }
    }

    # Rear Passive Caster Wheel (Low-friction ball touching floor at z=0)
    DEF CASTER_REAR Solid {
      translation -0.10 0 -0.02
      name "caster_rear"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.7 0.7 0.7
            metalness 0.9
            roughness 0.1
          }
          geometry Sphere {
            radius 0.02
          }
        }
      ]
      boundingObject Sphere {
        radius 0.02
      }
      physics Physics {
        density -1
        mass 0.1
      }
    }

    # Virtual Planar 360-degree LiDAR Sensor
    Lidar {
      translation 0 0 0.08
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.2
            metalness 0.8
          }
          geometry Cylinder {
            height 0.04
            radius 0.035
          }
        }
      ]
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.2831853
      numberOfLayers 1
      minRange 0.06
      maxRange 3.5
      defaultFrequency 10
    }

    # GPS for Ground-Truth Localization
    GPS {
      name "gps"
    }

    # Inertial Unit for Ground-Truth Heading
    InertialUnit {
      name "inertial_unit"
    }
  ]

  name "diff_robot"
  controller "autonomous_controller"
  supervisor TRUE

  boundingObject Pose {
    translation 0 0 0.015
    children [
      Cylinder {
        height 0.06
        radius 0.14
      }
    ]
  }

  physics Physics {
    density -1
    mass 3.5
    centerOfMass [
      0 0 -0.01
    ]
  }
}
